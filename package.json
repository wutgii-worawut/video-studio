{
  "name": "video-studio",
  "version": "1.0.0",
  "description": "Video Studio desktop workspace powered by React, Electron, Playwright and FFmpeg",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check:smoke": "node render.mjs skillz-promo check",
    "stills:smoke": "node render.mjs skillz-promo stills",
    "studio": "npm run ui:build && node studio.mjs 4183 --terminal --modern",
    "batch": "node batch.mjs",
    "recover": "node recovery.mjs",
    "benchmark": "node benchmark.mjs",
    "compose:sync": "node compose-sync.mjs",
    "audio:audit": "node audio-audit.mjs",
    "check:composition": "node render.mjs composition-demo check",
    "studio:terminal": "npm run studio",
    "studio:safe": "npm run ui:build && node studio.mjs 4177 --modern",
    "ui:build": "vite build --config app/vite.config.ts",
    "ui:dev": "vite --config app/vite.config.ts",
    "ui:check": "tsc --noEmit",
    "studio:legacy": "node studio.mjs 4184 --terminal",
    "electron": "npm run ui:build && electron .",
    "electron:dev": "electron .",
    "desktop:pack": "npm run ui:build && electron-builder --win --dir",
    "desktop:installer": "npm run ui:build && electron-builder --win nsis",
    "test:electron": "node tests/electron-smoke.spec.mjs",
    "test:ui": "node --test tests/react-studio.test.mjs",
    "test:desktop-render": "node tests/electron-render-smoke.spec.mjs",
    "postinstall": "node scripts/patch-node-pty.mjs",
    "pretest": "node scripts/patch-node-pty.mjs",
    "preui:build": "node scripts/patch-node-pty.mjs",
    "pretest:electron": "node scripts/patch-node-pty.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wutgii-worawut/video-studio.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wutgii-worawut/video-studio/issues"
  },
  "homepage": "https://github.com/wutgii-worawut/video-studio#readme",
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "node-pty": "1.1.0",
    "playwright": "^1.63.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "dev.video-studio.desktop",
    "productName": "Video Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "studio.mjs",
      "studio/dist/**/*",
      "studio/index.html",
      "studio/terminal.js",
      "studio/preview-bridge.js",
      "lib/**/*",
      "components/**/*",
      "render.mjs",
      "package.json",
      "!node_modules/.cache/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "workspace-seed",
        "filter": [
          "render.mjs",
          "lib/**/*",
          "components/**/*",
          "styles/**/*",
    "fonts/**/*",
    "libs/**/*",
          "sfx/**/*",
          "projects/composition-demo/source/**/*",
          "projects/composition-demo/brand/**/*",
          "!**/output/**/*"
        ]
      },
      {
        "from": "node_modules/playwright",
        "to": "workspace-seed/node_modules/playwright"
      },
      {
        "from": "node_modules/playwright-core",
        "to": "workspace-seed/node_modules/playwright-core"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Video-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  },
  "author": "Video Studio",
  "overrides": {
    "dompurify": "$dompurify"
  }
}
